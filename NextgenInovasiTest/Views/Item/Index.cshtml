@{
    ViewData["Title"] = "Items List";
}
<div class="card">
    <div class="card-header">
        <h4>Items List</h4>
    </div>
    <div class="card-body">
        <div class="container mt-4"></div>
        <div class="mb-4">
            <button id="exportPdf" class="btn btn-success btn-sm me-2"><i class="fa-solid fa-file-pdf"></i> Export to PDF</button>
            <button id="exportExcel" class="btn btn-primary btn-sm me-2"><i class="fa-solid fa-file-excel"></i> Export to Excel</button>
            <button id="downloadTemplate" class="btn btn-info btn-sm me-2"><i class="fa-solid fa-download"></i> Download Template</button>
            <label for="fileInput" class="btn btn-warning btn-sm">
                <i class="fa-solid fa-upload"></i> Upload File
                <input type="file" id="fileInput" style="display: none;" />
            </label>
        </div>

        <div class="card">
            <div class="card-body">
                <table id="itemTable" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/item.js" asp-append-version="true"></script>
}
